# MunshiJee Production Environment Variables

# Database Connection
# Replace with your actual PostgreSQL credentials
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/munshijee?schema=public"

# Application URL (use your actual domain)
NEXTAUTH_URL="https://munshijee.ideageek.pk"

# NextAuth Secret (keep this secret and random)
NEXTAUTH_SECRET="RLyP1e58mJ3WqYxauVz33mQoFgpWVYrF"

# Environment
NODE_ENV="production"

# Super Admin (optional, for seed script)
ADMIN_EMAIL="superadmin@munshijee.ideageek.pk"
ADMIN_PASSWORD="admin123!@#"

# Email Service (Resend) - Configure in Settings page after login
# RESEND_API_KEY="your_resend_api_key"

# SMS Service (Twilio) - Configure in Settings page after login
# TWILIO_ACCOUNT_SID="your_twilio_sid"
# TWILIO_AUTH_TOKEN="your_twilio_token"
# TWILIO_PHONE_NUMBER="your_twilio_phone"

# Redis (Optional - for background jobs)
# REDIS_URL="redis://localhost:6379"

# Server Port (optional, defaults to 3000)
# PORT=3000
