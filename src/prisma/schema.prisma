generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  USER
}

enum InvoiceType {
  ONE_TIME
  RECURRING
  BULK
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
  OTHER
}

enum NotificationType {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  password    String
  phoneNumber String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers     Customer[]
  invoices      Invoice[]
  sales         Sale[]
  payments      Payment[]
  settings      Settings[]

  @@index([email])
  @@index([role])
}

model Customer {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String
  contactAddress  String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoices Invoice[]
  sales    Sale[]
  payments Payment[]

  @@unique([userId, email])
  @@index([userId])
  @@index([email])
  @@index([isActive])
}

model Invoice {
  id                   String             @id @default(cuid())
  invoiceNumber        String             @unique
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId           String
  customer             Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type                 InvoiceType
  amount               Decimal            @db.Decimal(10, 2)
  status               InvoiceStatus      @default(DRAFT)
  issueDate            DateTime           @default(now())
  dueDate              DateTime
  isRecurring          Boolean            @default(false)
  recurringFrequency   RecurringFrequency?
  nextBillingDate      DateTime?
  notes                String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  sales    Sale[]
  notifications NotificationLog[]

  @@index([userId])
  @@index([customerId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([nextBillingDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  @@index([invoiceId])
}

model Sale {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(10, 2)
  saleDate    DateTime @default(now())
  invoiced    Boolean  @default(false)
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([invoiced])
  @@index([saleDate])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(10, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod
  reference   String?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentDate])
}

model Settings {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, userId])
  @@index([userId])
  @@index([key])
}

model NotificationLog {
  id           String             @id @default(cuid())
  invoiceId    String
  invoice      Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type         NotificationType
  provider     String
  recipient    String
  status       NotificationStatus
  errorMessage String?            @db.Text
  sentAt       DateTime?
  createdAt    DateTime           @default(now())

  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
}
